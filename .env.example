# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. .env is git-ignored - never commit keys.
# `make up` creates .env from this file automatically on the first run.
# ---------------------------------------------------------------------------

# -------------------------------- backend ---------------------------------
# Key pool, comma separated, at least 2 keys.
# Ids are assigned in this order: key_1, key_2, key_3 ...
LLM_API_KEYS=replace-with-first-api-key,replace-with-second-api-key

# LiteLLM model name(s), comma separated.
#   one model      -> every key uses it
#   N models, N keys -> paired by position (key_1 -> model 1, key_2 -> model 2)
# Examples: gemini/gemini-2.0-flash | groq/llama-3.1-8b-instant | openai/gpt-4o-mini
LLM_MODELS=gemini/gemini-2.0-flash

# SQLite location. In Docker this path sits on the named volume.
DATABASE_URL=sqlite:////data/app.db

# CORS: origins allowed to call the backend (comma separated).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the X-Simulate-Failure test hook. Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true

# LiteLLM cache: disk (persists on the volume) or memory.
CACHE_TYPE=disk
CACHE_DIR=/data/cache
CACHE_TTL_SECONDS=604800

# Provider call budget and history window.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
MAX_HISTORY_MESSAGES=40

# Default system prompt (optional, a built-in default is used when empty).
DEFAULT_SYSTEM_PROMPT=You are a concise, helpful assistant. Answer clearly and stay on topic.

LOG_LEVEL=INFO

# -------------------------------- frontend --------------------------------
# Base URL of the backend, used at build time and at container start.
VITE_API_BASE_URL=http://localhost:8000
